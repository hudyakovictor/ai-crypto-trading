# ============================================================================
#  ОКРУЖЕНИЕ ЛАБОРАТОРИИ
#  Скопируйте в .env.local и заполните. Файл .env* в .gitignore — не коммитится.
# ============================================================================

# --- Обязательное -----------------------------------------------------------

# Postgres, где живёт бумажный журнал: прогнозы, исходы, веса обучения.
# Локально поднимается одной командой: docker compose up -d db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/crypto_dev

# --- Автопилот --------------------------------------------------------------

# 0 — не запускать серверное расписание (циклы только вручную:
# POST /api/research/cycle или клавиша R в UI). Любое другое значение — запустить.
# AUTOPILOT=0

# --- Модель (необязательно: без ключей работает детерминированный glassbox) --
# Порядок провайдеров, их включённость и ключи, введённые в UI, хранятся в БД
# (таблица ai_provider_settings). Переменные ниже — значения по умолчанию,
# которые UI показывает и использует, если в настройках пусто.

# NVIDIA NIM
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenCode Zen
# OPENCODE_API_KEY=...
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_MODEL=claude-sonnet-4-5

# gpt4free (ключ не нужен)
# GPT4FREE_BASE_URL=https://api.gpt4free.co/v1
# GPT4FREE_MODEL=gpt-3.5-turbo

# --- Биржа ------------------------------------------------------------------
# OKX используется ТОЛЬКО для чтения публичных котировок (тикеры, свечи,
# стакан, фандинг, открытый интерес). Ключи биржи системе не нужны: ордеров
# нет, журнал бумажный. Базовый адрес задан константой в src/lib/okx/okx-client.ts.
